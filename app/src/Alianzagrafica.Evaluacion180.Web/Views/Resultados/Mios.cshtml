@model MisResultadosViewModel
@{
    ViewData["Title"] = "Mis resultados";

    // Entregable 12: los promedios ya están en % (0-100), igual que las calificaciones
    // individuales de la evaluación — se muestran con el símbolo % y, junto al promedio
    // general, con la banda cualitativa de EscalaCalificacion (Deficiente/Aceptable/Bueno/
    // Sobresaliente), igual que en Diligenciar.cshtml y en el resumen-imagen de WhatsApp/correo.
    string ConPorcentaje(decimal? valor) => valor.HasValue ? valor.Value.ToString("0.00") + "%" : "—";
}

<h1 class="h3 mt-4 mb-4">Mis resultados — @Model.NombreEmpleado</h1>

@if (Model.Historico.Count == 0)
{
    <p class="text-muted">Todavía no tienes resultados consolidados. Aparecerán aquí cuando termines un periodo de evaluación completo.</p>
}
else
{
    <div class="table-responsive">
        <table class="table bg-white align-middle">
            <thead>
                <tr>
                    <th>Periodo</th>
                    <th>Autoevaluación</th>
                    <th>Evaluación del jefe</th>
                    <th>Evaluación ascendente</th>
                    <th>Promedio general</th>
                    <th>Resultado</th>
                    <th>Consolidado el</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Historico)
                {
                    <tr>
                        <td>@r.PeriodoNombre</td>
                        <td>@ConPorcentaje(r.PromedioAutoevaluacion)</td>
                        <td>@ConPorcentaje(r.PromedioJefe)</td>
                        <td>@ConPorcentaje(r.PromedioAscendente)</td>
                        <td><strong>@ConPorcentaje(r.PromedioGeneral)</strong></td>
                        <td>
                            @if (r.PromedioGeneral is decimal pg)
                            {
                                <span class="badge @EscalaCalificacion.ClaseBadge(pg)">@EscalaCalificacion.Clasificar(pg)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="small text-muted">@(r.FechaConsolidacion?.ToString("dd/MM/yyyy") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
