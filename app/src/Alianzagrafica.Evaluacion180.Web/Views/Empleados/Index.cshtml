@model List<EmpleadoListaItemViewModel>
@{
    ViewData["Title"] = "Empleados";
}

<h1 class="h3 mt-4 mb-1">Empleados</h1>
<div class="aviso-ficticio mb-3">
    Esta información proviene hoy de la tabla ficticia de empleados. En producción se sincroniza
    en modo de solo lectura desde Novasoft (sección 8.4 del documento de diseño) — este sistema
    nunca edita datos maestros de empleados. La única excepción es el número de WhatsApp de la
    columna "WhatsApp" de abajo: se usa solo para el envío del resumen de resultados (RF-23) y se
    guarda por fuera de los datos de Novasoft.
</div>

<form method="get" class="mb-3" style="max-width: 360px;">
    <input type="text" name="q" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar por nombre, cargo o área..." />
</form>

<div class="table-responsive">
    <table class="table table-sm bg-white align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Cargo</th>
                <th>Área</th>
                <th>Tipo de personal</th>
                <th>Jefe directo</th>
                <th>Estado</th>
                <th>WhatsApp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.CodigoEmpleado</td>
                    <td>@e.Nombre</td>
                    <td>@e.Cargo</td>
                    <td>@e.Area</td>
                    <td><span class="badge badge-relacion">@e.TipoPersonal</span></td>
                    <td>@(e.JefeDirecto ?? "—")</td>
                    <td>
                        <span class="badge @(e.Estado == Constantes.EstadoEmpleadoActivo ? "badge-completada" : "bg-secondary")">@e.Estado</span>
                    </td>
                    <td style="min-width: 220px;">
                        <form method="post" asp-action="ActualizarContacto" asp-controller="Empleados" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="codigoEmpleado" value="@e.CodigoEmpleado" />
                            <input type="tel" name="telefonoWhatsApp" value="@e.TelefonoWhatsApp" class="form-control form-control-sm"
                                   placeholder="Ej: 3001234567" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Guardar número de WhatsApp">Guardar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
