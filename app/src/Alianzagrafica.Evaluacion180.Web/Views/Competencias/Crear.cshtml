@model CrearCompetenciaViewModel
@{
    ViewData["Title"] = "Nueva competencia";
}

<h1 class="h3 mt-4 mb-4">Nueva competencia</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Crear" method="post" class="bg-white p-4 rounded shadow-sm" style="max-width: 560px;">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="IdTipoPersonal" class="form-label"></label>
        <select asp-for="IdTipoPersonal" class="form-select">
            <option value="">Genérica (todos los tipos de personal)</option>
            @foreach (var t in Model.TiposDisponibles)
            {
                <option value="@t.IdTipoPersonal">@t.Nombre</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Categoria" class="form-label"></label>
        <select asp-for="Categoria" class="form-select">
            <option value="">Sin categoría (reparto parejo entre todas las competencias del formulario)</option>
            <option value="Organizacional">Organizacional (EVALUACION DE COMPETENCIAS ORGANIZACIONALES)</option>
            <option value="DeRol">De Rol (EVALUACION DE COMPETENCIAS DE ROL)</option>
        </select>
        <span class="form-text">
            Si al menos una competencia de un formulario tiene macro-grupo, el 100% se reparte en
            partes iguales entre los grupos presentes (ej. 50%/50%), y dentro de cada grupo en
            partes iguales entre sus competencias.
        </span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
