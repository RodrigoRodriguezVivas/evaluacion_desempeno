@model DiligenciarEvaluacionViewModel
@{
    ViewData["Title"] = "Diligenciar evaluación";

    // Agrupa las competencias por macro-grupo (RF-07: "Organizacional" / "DeRol"), preservando
    // el orden en que llegaron (el controlador ya las ordena por Categoria, luego Nombre, así que
    // las de un mismo grupo quedan contiguas). Se conserva el índice original de cada item en
    // Model.Items para que los campos ocultos (asp-for="Items[idx]...") sigan enlazando al
    // elemento correcto de la lista al hacer postback, sin importar el orden de recorrido aquí.
    var gruposCompetencias = Model.Items
        .Select((item, idx) => (item, idx))
        .GroupBy(x => x.item.Categoria)
        .ToList();

    // Solo se considera que el formulario usa macro-grupos de competencias si hay al menos 2
    // categorías reales (Organizacional / DeRol) presentes.
    var categoriasConEtiqueta = new HashSet<string>(gruposCompetencias
        .Where(g => g.Key == "Organizacional" || g.Key == "DeRol")
        .Select(g => g.Key!));
    var usaMacroGrupos = categoriasConEtiqueta.Count >= 2;
    var hayIndicadores = Model.Indicadores.Count > 0;
    // Se muestra la fila/sección "NOTA FINAL" combinada en cuanto hay más de un macro-grupo
    // evaluable en el formulario (2 de competencias, o competencias + indicadores).
    var mostrarNotaFinal = usaMacroGrupos || hayIndicadores;

    string? EtiquetaGrupo(string? categoria) => categoria switch
    {
        "Organizacional" => "Evaluación de competencias organizacionales",
        "DeRol" => "Evaluación de competencias de rol",
        _ => null,
    };

    // Texto "88.50% (Bueno)" para mostrar un valor en % junto a su banda cualitativa
    // (EscalaCalificacion, Entregable 12 — misma clasificación en toda la aplicación).
    string ConBanda(decimal? porcentaje) => porcentaje is decimal p
        ? $"{p.ToString("0.00")}% ({EscalaCalificacion.Clasificar(p)})"
        : "—";

    (decimal? Subtotal, decimal PesoGrupo) CalcularSubtotal(IEnumerable<ItemCompetenciaViewModel> items)
    {
        var lista = items.ToList();
        var pesoGrupo = lista.Sum(i => i.Ponderacion);
        var respondidos = lista.Where(i => i.Calificacion.HasValue).ToList();
        var sumaPesoRespondidos = respondidos.Sum(i => i.Ponderacion);
        decimal? subtotal = respondidos.Count > 0 && sumaPesoRespondidos > 0
            ? Math.Round(respondidos.Sum(i => i.Calificacion!.Value * i.Ponderacion) / sumaPesoRespondidos, 2)
            : null;
        return (subtotal, pesoGrupo);
    }

    (decimal? Subtotal, decimal PesoGrupo) CalcularSubtotalIndicadores(IEnumerable<ItemIndicadorViewModel> items)
    {
        var lista = items.ToList();
        var pesoGrupo = lista.Sum(i => i.Ponderacion);
        var respondidos = lista.Where(i => i.ResultadoMes.HasValue).ToList();
        var sumaPesoRespondidos = respondidos.Sum(i => i.Ponderacion);
        decimal? subtotal = respondidos.Count > 0 && sumaPesoRespondidos > 0
            ? Math.Round(respondidos.Sum(i => i.ResultadoMes!.Value * i.Ponderacion) / sumaPesoRespondidos, 2)
            : null;
        return (subtotal, pesoGrupo);
    }

    var (subtotalIndicadores, pesoGrupoIndicadores) = CalcularSubtotalIndicadores(Model.Indicadores);

    // NOTA FINAL combinada: un único promedio ponderado sobre TODOS los ítems evaluables
    // (competencias e indicadores de gestión, ambos ya en la misma escala nativa 0-100% desde el
    // Entregable 12 — sin ninguna conversión de escala), usando el peso absoluto ya calculado de
    // cada uno (Ítem.Ponderacion) — misma fórmula que ResultadoService.PromedioPonderado en el servidor.
    decimal? notaFinal;
    {
        var valoresCompetencias = Model.Items.Where(i => i.Calificacion.HasValue)
            .Select(i => (Valor: i.Calificacion!.Value, Peso: i.Ponderacion));
        var valoresIndicadores = Model.Indicadores.Where(i => i.ResultadoMes.HasValue)
            .Select(i => (Valor: i.ResultadoMes!.Value, Peso: i.Ponderacion));
        var todos = valoresCompetencias.Concat(valoresIndicadores).ToList();
        var sumaPeso = todos.Sum(x => x.Peso);
        notaFinal = todos.Count > 0 && sumaPeso > 0 ? Math.Round(todos.Sum(x => x.Valor * x.Peso) / sumaPeso, 2) : (decimal?)null;
    }
}

<h1 class="h3 mt-4">Evaluación — @Model.TipoRelacionTexto</h1>
<p class="text-muted">
    Evaluado: <strong>@Model.NombreEvaluado</strong> (@Model.CargoEvaluado) · Periodo: @Model.PeriodoNombre<br />
    Formulario: @Model.NombreFormulario
</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.Items.Count == 0 && Model.Indicadores.Count == 0)
{
    <div class="alert alert-warning">Este formulario no tiene competencias ni indicadores configurados todavía. Contacta al administrador de Gestión Humana.</div>
}
else
{
    <p class="escala-ayuda">
        Escala de calificación: un valor en porcentaje, de <strong>0%</strong> (mínimo) a <strong>100%</strong> (máximo), tanto para
        competencias como para indicadores de gestión.
    </p>
    <p class="escala-ayuda small text-muted">
        Equivalencia con las bandas de desempeño del formato interno GHU-FOR-007:
        0%-59% Deficiente · 60%-79% Aceptable · 80%-90% Bueno · 91%-100% Sobresaliente.
    </p>
    @if (mostrarNotaFinal)
    {
        <p class="escala-ayuda small text-muted">
            Este formulario combina macro-grupos de evaluación, cada uno con su propio peso sobre la nota
            final@(hayIndicadores ? ": Indicadores de Gestión, Evaluación de competencias organizacionales y Evaluación de competencias de rol." : " (Evaluación de competencias organizacionales y de rol)."))
            Cada grupo se califica y se suma por separado (subtotal del grupo); la NOTA FINAL es la combinación de
            todos los subtotales, cada uno ya ponderado según su peso.
        </p>
    }

    <form asp-action="GuardarBorrador" method="post" id="formEvaluacion">
        <input type="hidden" asp-for="IdAsignacion" />
        <input type="hidden" asp-for="NombreEvaluado" />
        <input type="hidden" asp-for="CargoEvaluado" />
        <input type="hidden" asp-for="TipoRelacionTexto" />
        <input type="hidden" asp-for="NombreFormulario" />
        <input type="hidden" asp-for="PeriodoNombre" />
        <input type="hidden" asp-for="SoloLectura" />

        @if (hayIndicadores)
        {
            <h2 class="h5 mt-4">
                INDICADORES DE GESTIÓN (@pesoGrupoIndicadores.ToString("0.##")% del total)
            </h2>
            <p class="escala-ayuda small text-muted">
                La Meta de cada indicador es un valor fijo definido en el catálogo (no se edita aquí). Registra
                únicamente el Resultado del mes/periodo en porcentaje (ej. escribe <strong>90</strong> para 90%).
            </p>
            <div class="table-responsive">
                <table class="table tabla-competencias bg-white align-middle">
                    <thead>
                        <tr>
                            <th style="width: 18%">Nombre indicador</th>
                            <th>Fórmula</th>
                            <th style="width: 12%">Meta (%)</th>
                            <th style="width: 14%">Resultado del mes (%)</th>
                            <th style="width: 12%">Ponderación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var idx = 0; idx < Model.Indicadores.Count; idx++)
                        {
                            var indicador = Model.Indicadores[idx];
                            <tr data-indicador="1" data-ponderacion="@indicador.Ponderacion.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <td>
                                    <strong>@indicador.Nombre</strong>
                                    <input type="hidden" asp-for="Indicadores[idx].IdIndicador" />
                                    <input type="hidden" asp-for="Indicadores[idx].Nombre" />
                                    <input type="hidden" asp-for="Indicadores[idx].Formula" />
                                    <input type="hidden" asp-for="Indicadores[idx].Ponderacion" />
                                    <input type="hidden" asp-for="Indicadores[idx].Meta" />
                                </td>
                                <td class="small text-muted">@indicador.Formula</td>
                                <td>
                                    <span class="fw-bold">@indicador.Meta.ToString("0.##")%</span>
                                </td>
                                <td>
                                    @if (Model.SoloLectura)
                                    {
                                        <span class="fw-bold">@(indicador.ResultadoMes?.ToString("0.##") ?? "—")@(indicador.ResultadoMes.HasValue ? "%" : "")</span>
                                    }
                                    else
                                    {
                                        <input type="number" step="0.01" min="0" max="100" asp-for="Indicadores[idx].ResultadoMes" class="form-control form-control-sm" data-resultado-mes="1" />
                                    }
                                </td>
                                <td>@indicador.Ponderacion.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-semibold" data-subtotal-indicadores="1">
                            <td colspan="4" class="text-end">Subtotal — Indicadores de Gestión</td>
                            <td class="subtotal-valor-indicadores">
                                @(subtotalIndicadores is not null ? ConBanda(subtotalIndicadores) : "— (faltan resultados)")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="escala-ayuda small text-muted">
                La suma de las ponderaciones individuales de los indicadores puede no dar exactamente 100% dentro
                del grupo (en este formato, 33.33% × 4 = 133.32%) — se dejó tal como está en el formato de origen;
                por eso el peso efectivo de este grupo en la NOTA FINAL puede ser algo mayor a su peso nominal.
            </p>
        }

        @if (Model.Items.Count > 0)
        {
            <h2 class="h5 mt-4">Competencias</h2>
            <p class="escala-ayuda small text-muted">
                Cada competencia se despliega en sus comportamientos observables (columna "COMPORTAMIENTOS" del
                formato interno). Califica cada comportamiento por separado, de 0% a 100%; la "Nota final" de la
                competencia es el promedio de sus comportamientos ya calificados — se calcula automáticamente, no
                se diligencia directamente.
            </p>
            <div class="table-responsive">
                <table class="table tabla-competencias bg-white align-middle">
                    <thead>
                        <tr>
                            <th style="width: 15%">Competencia</th>
                            <th style="width: 19%">Descripción</th>
                            <th>Comportamiento</th>
                            <th style="width: 11%">Nota individual (%)</th>
                            <th style="width: 9%">Nota final</th>
                            <th style="width: 7%">Ponderación</th>
                            <th style="width: 16%">Comentario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grupo in gruposCompetencias)
                        {
                            var etiquetaGrupo = EtiquetaGrupo(grupo.Key);
                            var (subtotalGrupo, pesoGrupo) = CalcularSubtotal(grupo.Select(x => x.item));

                            if (etiquetaGrupo is not null)
                            {
                                <tr class="table-secondary">
                                    <th colspan="7" class="small text-uppercase">
                                        @etiquetaGrupo.ToUpperInvariant() (@pesoGrupo.ToString("0.##")% del total)
                                    </th>
                                </tr>
                            }
                            @foreach (var (item, idx) in grupo)
                            {
                                var comportamientos = Model.Items[idx].Comportamientos;
                                var filas = comportamientos.Count > 0 ? comportamientos.Count : 1;
                                for (var cIdx = 0; cIdx < filas; cIdx++)
                                {
                                    var comportamiento = cIdx < comportamientos.Count ? comportamientos[cIdx] : null;
                                    <tr data-categoria="@(item.Categoria ?? "")">
                                        @if (cIdx == 0)
                                        {
                                            <td rowspan="@filas">
                                                <strong>@Model.Items[idx].Nombre</strong>
                                                <input type="hidden" asp-for="Items[idx].IdCompetencia" />
                                                <input type="hidden" asp-for="Items[idx].Nombre" />
                                                <input type="hidden" asp-for="Items[idx].Categoria" />
                                                <input type="hidden" asp-for="Items[idx].Ponderacion" />
                                            </td>
                                            <td rowspan="@filas" class="small text-muted">@Model.Items[idx].Descripcion</td>
                                        }
                                        @if (comportamiento is not null)
                                        {
                                            <td class="small">
                                                @comportamiento.Descripcion
                                                <input type="hidden" asp-for="Items[idx].Comportamientos[cIdx].IdComportamiento" />
                                                <input type="hidden" asp-for="Items[idx].Comportamientos[cIdx].Descripcion" />
                                            </td>
                                            <td>
                                                @if (Model.SoloLectura)
                                                {
                                                    <span class="fw-bold">@(comportamiento.Calificacion is decimal cc ? cc.ToString("0.##") + "%" : "—")</span>
                                                }
                                                else
                                                {
                                                    <input type="number" step="0.01" min="0" max="100"
                                                           asp-for="Items[idx].Comportamientos[cIdx].Calificacion"
                                                           class="form-control form-control-sm"
                                                           data-comportamiento="1" data-competencia-idx="@idx"
                                                           placeholder="0-100" />
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="small text-muted">(sin comportamientos configurados)</td>
                                            <td>—</td>
                                        }
                                        @if (cIdx == 0)
                                        {
                                            <td rowspan="@filas" class="fw-bold nota-final-competencia" data-nota-final-competencia="@idx"
                                                data-categoria="@(item.Categoria ?? "")" data-ponderacion="@item.Ponderacion.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                @(Model.Items[idx].Calificacion is decimal c ? c.ToString("0.##") + "%" : "—")
                                            </td>
                                            <td rowspan="@filas">@Model.Items[idx].Ponderacion%</td>
                                            <td rowspan="@filas">
                                                @if (Model.SoloLectura)
                                                {
                                                    <span class="small">@Model.Items[idx].Comentario</span>
                                                }
                                                else
                                                {
                                                    <textarea asp-for="Items[idx].Comentario" class="form-control form-control-sm" rows="2"></textarea>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            @if (etiquetaGrupo is not null)
                            {
                                <tr class="table-light fw-semibold" data-subtotal-grupo="@grupo.Key">
                                    <td colspan="5" class="text-end">Subtotal — @etiquetaGrupo</td>
                                    <td colspan="2" class="subtotal-valor">
                                        @(subtotalGrupo is not null ? ConBanda(subtotalGrupo) : "— (faltan calificaciones)")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (mostrarNotaFinal)
        {
            <div class="table-responsive">
                <table class="table bg-white align-middle mb-0">
                    <tbody>
                        <tr class="table-dark text-white">
                            <td class="fw-bold">NOTA FINAL (combina todos los macro-grupos según su peso)</td>
                            <td class="fw-bold text-end" id="nota-final-valor" style="width: 220px;">
                                @(notaFinal is not null ? ConBanda(notaFinal) : "— (faltan calificaciones/resultados)")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        <h2 class="h5 mt-4">Compromisos</h2>
        <div class="mb-3">
            <label asp-for="OportunidadesMejora" class="form-label fw-semibold">Oportunidades de mejora</label>
            <p class="escala-ayuda small text-muted mb-1">
                Describan los comentarios adicionales que considere pertinentes registrar (Trabajador y Jefe Inmediato).
            </p>
            @if (Model.SoloLectura)
            {
                <p class="small">@(string.IsNullOrWhiteSpace(Model.OportunidadesMejora) ? "—" : Model.OportunidadesMejora)</p>
            }
            else
            {
                <textarea asp-for="OportunidadesMejora" class="form-control" rows="3" maxlength="2000"></textarea>
            }
        </div>
        <div class="mb-3">
            <label asp-for="Compromisos" class="form-label fw-semibold">Compromisos</label>
            @if (Model.SoloLectura)
            {
                <p class="small">@(string.IsNullOrWhiteSpace(Model.Compromisos) ? "—" : Model.Compromisos)</p>
            }
            else
            {
                <textarea asp-for="Compromisos" class="form-control" rows="3" maxlength="2000"></textarea>
            }
        </div>
        <div class="mb-3">
            <label asp-for="RevisionCompromisos" class="form-label fw-semibold">Revisión de compromisos</label>
            <p class="escala-ayuda small text-muted mb-1">
                Este ítem lo revisan entre las dos partes, describiendo los compromisos realizados en las evaluaciones anteriores.
            </p>
            @if (Model.SoloLectura)
            {
                <p class="small">@(string.IsNullOrWhiteSpace(Model.RevisionCompromisos) ? "—" : Model.RevisionCompromisos)</p>
            }
            else
            {
                <textarea asp-for="RevisionCompromisos" class="form-control" rows="3" maxlength="2000"></textarea>
            }
        </div>

        @if (!Model.SoloLectura)
        {
            <div class="d-flex gap-2 mt-3">
                <button type="submit" formaction="@Url.Action("GuardarBorrador")" class="btn btn-outline-secondary">Guardar borrador</button>
                <button type="submit" formaction="@Url.Action("Enviar")" class="btn btn-primary" onclick="return confirm('Una vez enviada, la evaluación no se podrá editar. ¿Deseas continuar?');">Enviar evaluación definitiva</button>
                <a class="btn btn-link" asp-action="Mis">Cancelar</a>
            </div>

            @if (mostrarNotaFinal)
            {
                <script>
                    // Recalcula en vivo, en el navegador, los subtotales por macro-grupo (competencias e
                    // indicadores de gestión) y la nota final a medida que el evaluador va diligenciando —
                    // puramente visual/informativo; el cálculo que realmente cuenta es el que hace el
                    // servidor con los mismos datos al consolidar (ResultadoService), usando exactamente
                    // la misma fórmula. Desde el Entregable 12, competencias e indicadores ya están en la
                    // misma escala nativa (0-100%), así que no hace falta ninguna conversión aquí.
                    (function () {
                        var BANDAS = [
                            { limite: 60, nombre: 'Deficiente' },
                            { limite: 80, nombre: 'Aceptable' },
                            { limite: 90.0000001, nombre: 'Bueno' },
                            { limite: Infinity, nombre: 'Sobresaliente' },
                        ];
                        function clasificar(valor) {
                            for (var i = 0; i < BANDAS.length; i++) {
                                if (valor < BANDAS[i].limite) return BANDAS[i].nombre;
                            }
                            return 'Sobresaliente';
                        }
                        function conBanda(valor) {
                            return valor.toFixed(2) + '% (' + clasificar(valor) + ')';
                        }

                        function recalcular() {
                            var sumaPesoTotal = 0, sumaPonderadaTotal = 0;

                            // Paso 1: promedio por competencia, a partir de sus comportamientos ya
                            // calificados (ignora los comportamientos en blanco, igual que
                            // =AVERAGE(...) en el Excel origen). Agrupa por data-competencia-idx.
                            var comportamientosPorCompetencia = {};
                            document.querySelectorAll('#formEvaluacion input[data-comportamiento]').forEach(function (input) {
                                var idx = input.getAttribute('data-competencia-idx');
                                if (input.value === '') return;
                                if (!comportamientosPorCompetencia[idx]) comportamientosPorCompetencia[idx] = [];
                                comportamientosPorCompetencia[idx].push(parseFloat(input.value));
                            });
                            var promedioPorCompetencia = {};
                            Object.keys(comportamientosPorCompetencia).forEach(function (idx) {
                                var valores = comportamientosPorCompetencia[idx];
                                var suma = valores.reduce(function (a, b) { return a + b; }, 0);
                                promedioPorCompetencia[idx] = suma / valores.length;
                            });

                            // Paso 2: refleja la "Nota final" de cada competencia en su celda, y
                            // acumula por macro-grupo (Organizacional / DeRol) usando la
                            // ponderación de la competencia UNA sola vez (no por comportamiento).
                            var gruposCompetencias = {};
                            document.querySelectorAll('#formEvaluacion [data-nota-final-competencia]').forEach(function (celda) {
                                var idx = celda.getAttribute('data-nota-final-competencia');
                                var categoria = celda.getAttribute('data-categoria');
                                var ponderacion = parseFloat(celda.getAttribute('data-ponderacion')) || 0;
                                var promedio = promedioPorCompetencia[idx];

                                celda.textContent = (promedio !== undefined) ? (promedio.toFixed(2) + '%') : '—';

                                if (categoria !== 'Organizacional' && categoria !== 'DeRol') return;
                                if (!gruposCompetencias[categoria]) gruposCompetencias[categoria] = { sumaPeso: 0, sumaPonderada: 0 };
                                if (promedio !== undefined) {
                                    gruposCompetencias[categoria].sumaPeso += ponderacion;
                                    gruposCompetencias[categoria].sumaPonderada += ponderacion * promedio;
                                    sumaPesoTotal += ponderacion;
                                    sumaPonderadaTotal += ponderacion * promedio;
                                }
                            });
                            Object.keys(gruposCompetencias).forEach(function (categoria) {
                                var g = gruposCompetencias[categoria];
                                var celda = document.querySelector('tr[data-subtotal-grupo="' + categoria + '"] .subtotal-valor');
                                if (celda) {
                                    celda.textContent = g.sumaPeso > 0
                                        ? conBanda(g.sumaPonderada / g.sumaPeso)
                                        : '— (faltan calificaciones)';
                                }
                            });

                            // Indicadores de gestión
                            var indSumaPeso = 0, indSumaPonderada = 0;
                            document.querySelectorAll('#formEvaluacion tr[data-indicador]').forEach(function (fila) {
                                var ponderacion = parseFloat(fila.getAttribute('data-ponderacion')) || 0;
                                var inputResultado = fila.querySelector('input[data-resultado-mes]');
                                var valor = inputResultado ? inputResultado.value : '';
                                if (valor !== '') {
                                    var numero = parseFloat(valor);
                                    indSumaPeso += ponderacion;
                                    indSumaPonderada += ponderacion * numero;
                                    sumaPesoTotal += ponderacion;
                                    sumaPonderadaTotal += ponderacion * numero;
                                }
                            });
                            var celdaIndicadores = document.querySelector('[data-subtotal-indicadores] .subtotal-valor-indicadores');
                            if (celdaIndicadores) {
                                celdaIndicadores.textContent = indSumaPeso > 0
                                    ? conBanda(indSumaPonderada / indSumaPeso)
                                    : '— (faltan resultados)';
                            }

                            var notaFinalEl = document.getElementById('nota-final-valor');
                            if (notaFinalEl) {
                                notaFinalEl.textContent = sumaPesoTotal > 0
                                    ? conBanda(sumaPonderadaTotal / sumaPesoTotal)
                                    : '— (faltan calificaciones/resultados)';
                            }
                        }

                        document.querySelectorAll('#formEvaluacion input[data-comportamiento]').forEach(function (input) {
                            input.addEventListener('input', recalcular);
                            input.addEventListener('change', recalcular);
                        });
                        document.querySelectorAll('#formEvaluacion input[data-resultado-mes]').forEach(function (input) {
                            input.addEventListener('input', recalcular);
                            input.addEventListener('change', recalcular);
                        });
                        recalcular();
                    })();
                </script>
            }
        }
        else
        {
            <div class="mt-3">
                <span class="badge badge-completada">Evaluación enviada — solo lectura</span>
                <a class="btn btn-link" asp-action="Mis">Volver</a>
            </div>
        }
    </form>
}
